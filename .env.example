# Copy this file to .env and fill in your local values.
# .env is gitignored and should never be committed.

# Database
# PostgreSQL connection string. Use a strong password before any shared deployment.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://luminos:change-me-now@localhost:5432/luminos_engine
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Admin protection
# Required on startup unless LUMINOS_ENFORCE_ADMIN_SECRET=false.
LUMINOS_ADMIN_SECRET=replace-with-a-long-random-secret
LUMINOS_ENFORCE_ADMIN_SECRET=true

# Application auth
LUMINOS_AUTH_REQUIRED=true
LUMINOS_SESSION_SECRET=replace-with-a-second-long-random-secret
LUMINOS_BOOTSTRAP_ADMIN_USERNAME=admin
LUMINOS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
LUMINOS_BOOTSTRAP_TEACHER_USERNAME=teacher
LUMINOS_BOOTSTRAP_TEACHER_PASSWORD=replace-with-a-strong-teacher-password

# Web security
# Comma-separated list. Example: http://localhost:8000,http://127.0.0.1:8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Logging and error tracking
LOG_LEVEL=INFO
LOG_FORMAT=text
SENTRY_DSN=

# TTS runtime
LUMINOS_TTS_CACHE_DIR=/tmp/luminos-tts-cache
LUMINOS_TTS_PREWARM_ENABLED=true
LUMINOS_TTS_STRICT_STARTUP=false
LUMINOS_TTS_CACHE_PRUNE_ON_STARTUP=true
LUMINOS_TTS_CACHE_RETENTION_DAYS=30
LUMINOS_TTS_LOCK_TIMEOUT_SECONDS=20
LUMINOS_TTS_LOCK_STALE_SECONDS=120
LUMINOS_TTS_PREWARM_TEXT=Luminos is ready.

# Kokoro defaults
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0
KOKORO_SAMPLE_RATE=24000

# Rate limits
# Format: <path-prefix>:<limit>:<window-seconds>,...
LUMINOS_RATE_LIMITS=/lesson/tts/prompt:5:60,/admin/:10:60,/lesson/:180:60
