          "content_payload": {
            "front_text": "ship / sheep",
            "back_text": "Short vowel vs long vowel"
          },
          "teacher_cue": "These are different English vowels. ship is short and quick. sheep is long and held. The vowel changes the word meaning.",
          "expected_response": "Students understand that the vowel change makes a new word.",
          "correction_move": "Model short vs long and have students repeat in alternation.",
          "observation_note": "Watch whether students collapse both words into one vowel quality.",
          "korean_interference_flag": "vowel_quality",
          "markable": true,
          "marking_options": [
            "secure",
            "shaky",
            "missed"
          ],
          "next_action": "manual_next"
        },
        {
          "slide_id": "03-02",
          "block_id": "03",
          "slide_title": "Choose: ship or sheep?",
