      "label": "New Sound Introduction",
      "slides": [
        {
          "slide_id": "03-01",
          "block_id": "03",
          "slide_title": "Introduce /k/ — c and k",
          "view_type": "flashcard",
          "content_payload": {
            "front_text": "c / k",
            "back_text": "/k/",
            "audio": null
          },
          "phoneme": "/k/",
          "grapheme": "c / k",
          "articulation_note": "Voiceless velar stop. The back of the tongue rises to touch the soft palate at the back of the mouth, builds pressure, releases with a burst. No voicing.",
          "spelling_rule": "c — used before a, o, u and at the end of words after consonants: cat · cap · can. k — used before e, i to avoid confusion: kit · kick · king. Both graphemes represent the same phoneme /k/.",
          "teacher_cue": null,
          "expected_response": "Students produce /k/ accurately. Students understand two spellings represent one sound.",
          "correction_move": "Model /k/ — exaggerate the back-of-mouth release. Review c vs k spelling rule.",
          "observation_note": "Introduce both graphemes together this lesson.",
          "korean_interference_flag": null,
          "markable": true,
          "marking_options": [
            "secure",
            "shaky",
            "missed"
          ],
          "next_action": "manual_next"
        }
      ]
    },
